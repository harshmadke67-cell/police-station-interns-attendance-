# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Application Configuration
PORT=3000
NODE_ENV=development

# Session (only used for non-Supabase features if any)
SESSION_SECRET=your_long_random_secret_here

# Office account login; OFFICE_EMAIL is only needed when initially provisioning a profile
OFFICE_USERNAME=your_office_id
OFFICE_PASSWORD=your_secure_password_here

# Supabase Auth email used when initially provisioning the office profile
OFFICE_EMAIL=office@yourdomain.example
